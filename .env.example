# Copy to .env.local and fill in. Both values are public (they ship to the browser).
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local development against scripts/local-api.ts instead of Supabase:
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=local-dev

# Never put the service-role key or the admin PIN in this file or any VITE_ variable.
